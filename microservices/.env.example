# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Gateway ──────────────────────────────────────────────────────────────
API_GATEWAY_PORT=4000

# ─── Exam Microservice ────────────────────────────────────────────────────────
EXAM_SERVICE_PORT=4004

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/exam-portal

# ─── Redis ────────────────────────────────────────────────────────────────────
# Supports both plain (REDIS_*) and Railway-style (REDIS*) variable names
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Platform Admin ───────────────────────────────────────────────────────────
# Used to protect the POST /organizations endpoint (server-admin only)
PLATFORM_KEY=change-me-platform-key

# ─── Invite Base URL ──────────────────────────────────────────────────────────
# Base URL used when generating invite links sent via email
API_BASE_URL=http://localhost:4000

# ─── AWS S3 (violation screenshot uploads) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── AI — Groq (LLM for question generation) ──────────────────────────────────
GROQ_API_KEY=

# ─── AI — Google Gemini (embeddings) ─────────────────────────────────────────
GEMINI_API_KEY=

# ─── AI — Qdrant (vector database) ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
